# Copy the line below into the "Secrets" box when deploying on Streamlit Community
# Cloud (App settings -> Secrets). Never commit a real secrets.toml — it is
# gitignored.
#
# Streamlit exposes root-level secrets as environment variables, which is how the
# app's config loader (os.getenv("GEMINI_API_KEY")) picks this up with no code
# change.

GEMINI_API_KEY = "your-gemini-api-key"
