# The build context. Anything not needed to build or run the app stays out —
# above all secrets, and the publisher PDFs, which must not end up in an image.

# Secrets
.env
*.env
!.env.example

# Licensed source papers: the app ships the built index, never the PDFs
knowledge source

# Local environments and tooling
.git
.venv
venv
env
**/__pycache__
**/*.pyc
.pytest_cache
.coverage
htmlcov
notebooks

# Not used at runtime
tests
data/raw
data/processed
data/vectordb_dev
*.md

# Frontend artefacts: the image builds its own
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
