# Copy to .env and fill in. Never commit the real file.

# The consultant's model (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# ── Deployment only (docker compose) ──────────────────────────────────────────
# The free DuckDNS subdomain pointing at the server's public IP
DOMAIN=yourname.duckdns.org

# Basic auth, keeping the site private. Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_USER=hydroassist
BASIC_AUTH_HASH='$2a$14$replace-with-the-generated-hash'

# ── Optional: the consultant's free-tier guardrails ───────────────────────────
# HYDROASSIST_CHAT_PER_SESSION=20
# HYDROASSIST_CHAT_WINDOW_S=600
# HYDROASSIST_CHAT_PER_DAY=500
