.coverage
htmlcov/
.pytest_cache/
.tox/

# Claude Code machine-specific config
.claude/settings.local.json

# Frontend (React + Vite). The built SPA is produced by `npm run build` at
# deploy time and served by FastAPI; it is not committed.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
npm-debug.log*

